#### meta start
#### project Whonix
#### category time and firewall
#### description
## Restarts whonix-firewall when /run/sdwdate/first_success status file was
## created, i.e. when sdwdate succeeded so Whonix firewall will move from
## timesync-fail-closed mode to full mode.
##
## Starts <code>/usr/libexec/whonix-firewall/firewall-restarter</code>.
#### meta end

[Unit]
Description=Whonix firewall watcher
Documentation=https://www.whonix.org/wiki/Whonix_Firewall

Before=sdwdate.service
Before=qubes-whonix-torified-updates-proxy-check.service

After=whonix-firewall.service

[Service]
Type=simple

SuccessExitStatus=143
KillMode=control-group
PrivateTmp=true
## Shrink the file-backed exec residual for this root daemon: ProtectSystem=full
## makes /usr,/boot,/etc read-only and ProtectHome hides homes (it only reads
## /run/sdwdate and asks systemd over D-Bus). Not strict: it may touch /var,/run.
ProtectSystem=full
ProtectHome=true

## W^X hardening (anonymous + file-backed). MemoryDenyWriteExecute denies anon
## W+X and mprotect/shmat gaining PROT_EXEC; SystemCallArchitectures=native closes
## the secondary-ABI (i386) bypass; LockPersonality blocks READ_IMPLIES_EXEC;
## SystemCallFilter=~memfd_create kills the memfd bypass; NoExecPaths marks the
## writable dirs non-executable (file-backed exec). firewall-restarter is bash; it
## waits on sdwdate then asks systemd over D-Bus to restart whonix-firewall.service
## -- the firewall rules run in THAT separate unit, not as a child here, so no
## privilege-gaining child inherits this unit's restrictions. (W^X itself does
## not require no_new_privs: MDWE is the PR_SET_MDWE prctl and the ~memfd_create
## seccomp installs via the root executor's CAP_SYS_ADMIN -- both independent of
## no_new_privs.)
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
LockPersonality=true
SystemCallFilter=~memfd_create
NoExecPaths=/run /tmp /var/tmp /dev/shm /dev

## Defense-in-depth (separate axis from W^X): NoNewPrivileges blocks this root
## daemon from gaining privileges (setuid/setgid, file capabilities, AppArmor
## non-subset Px). The restart is a systemctl D-Bus call to PID1 (the firewall
## rules run in whonix-firewall.service, not as a child here), so nothing here
## needs privilege gain.
NoNewPrivileges=yes

ExecStart=/usr/libexec/whonix-firewall/firewall-restarter

[Install]
WantedBy=multi-user.target
